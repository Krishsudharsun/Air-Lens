# Copy to .env.local, fill in what you have.
VITE_API_BASE_URL=http://localhost:4000

# Google Maps JavaScript API key, used ONLY to render the real map +
# route polyline in the browser. Use a SEPARATE key from your backend
# GOOGLE_MAPS_API_KEY, restricted to "Maps JavaScript API" and to your
# site's HTTP referrer (this key is visible in the browser).
# Get one free at https://console.cloud.google.com/google/maps-apis
# With no key set, the app falls back to a simple built-in route
# preview — everything else still works.
VITE_GOOGLE_MAPS_API_KEY=
