# Copy this file to .env and fill in the keys you have. The app still
# runs with none of these set (falls back to free OSRM/Nominatim
# routing/geocoding + Open-Meteo air quality + mock data as a last
# resort) — but for real map data and Tamil Nadu real-time air
# quality, add these:

PORT=4000

# --- Maps (routing + geocoding) ---
# Google Maps Platform key with "Directions API" and "Geocoding API"
# enabled. Powers real road-network routes, real alternative routes,
# and live-traffic-aware ETAs. Get one free (with $200/month credit)
# at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# --- Air quality (real-time, Tamil Nadu) ---
# data.gov.in API key — unlocks the CPCB real-time Air Quality Index
# feed (official Indian government monitoring stations), filtered to
# Tamil Nadu. This is the primary, most accurate source for this
# prototype. Free, instant signup:
# https://data.gov.in -> Sign Up -> My Account -> API keys
DATA_GOV_IN_API_KEY=

# --- Air quality (real-time, fallback / anywhere) ---
# WAQI (aqicn.org) token — real-time global air-quality station
# network, used when a point falls outside CPCB's Tamil Nadu
# coverage, or if DATA_GOV_IN_API_KEY isn't set. Free, instant token:
# https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=
